# Bifrost Gateway URL (Run Bifrost locally via Docker/CLI on port 8080, or use Bifrost Cloud endpoint)
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=your_bifrost_or_provider_key_here

# Models configured inside Bifrost Gateway
FAST_MODEL=groq/llama-3.1-8b-instant
VERIFIER_MODEL=openai/gpt-4o-mini

# Tavily API Key (Get free key from app.tavily.com)
TAVILY_API_KEY=tvly-your-api-key-here